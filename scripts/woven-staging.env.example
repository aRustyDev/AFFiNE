# Copy to scripts/woven-staging.env (git-excluded). woven-promote.sh overwrites
# AFFINE_IMAGE at run time with the candidate being staged.
AFFINE_IMAGE=ghcr.io/toeverything/affine:stable
STAGING_PORT=3020
STAGING_PG_PORT=5442
STAGING_REDIS_PORT=6389
DB_USERNAME=affine
DB_PASSWORD=affine
DB_DATABASE=affine
# Bind roots for staging data (absolute paths, NO ~). Defaults set by woven-promote.sh
# to $HOME/.affine/staging/{pgdata,storage,config} if left unset.
# DB_DATA_LOCATION=/abs/pgdata
# UPLOAD_LOCATION=/abs/storage
# CONFIG_LOCATION=/abs/config
